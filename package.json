{
  "name": "walking-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Walking Companion: incline treadmill interval coach for iPhone (Capacitor 8).",
  "type": "module",
  "config": {
    "supportEmail": "support@walkingcompanion.app",
    "supportUrl": "https://github.com/walideltayeh/Route-Optimizer-New/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "test": "node tests/logic.mjs && node scripts/build.mjs --dev && node tests/e2e.mjs && node tests/migration.mjs",
    "ios:sync": "node scripts/build.mjs && npx cap sync ios",
    "ios:wire": "node native/wire-ios.mjs",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.25.12"
  }
}
