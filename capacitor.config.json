{
  "appId": "com.example.walkingcompanion",
  "appName": "Walking Companion",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "showSpinner": false
    },
    "LocalNotifications": {
      "presentationOptions": []
    },
    "StatusBar": {
      "style": "DEFAULT"
    }
  }
}
